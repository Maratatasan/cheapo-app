# AWS CLI profile and assigned Region. Fill in the Cheapo project's account ID.
CHEAPO_AWS_PROFILE=cheapo
CHEAPO_AWS_REGION=eu-north-1
CHEAPO_AWS_ACCOUNT_ID=

# Shared by both stack operations.
CHEAPO_VPC_ID=

# Required for the storage stack.
CHEAPO_DB_SUBNET_A_CIDR=
CHEAPO_DB_SUBNET_B_CIDR=

# Required for the temporary access stack. Use the deployed database SG output.
CHEAPO_RUNNER_SUBNET_ID=
CHEAPO_DB_SECURITY_GROUP_ID=
