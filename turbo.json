{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc"],
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["CHEAPO_AUTH_TEST", "CHEAPO_FIELD_TEST", "EXPO_*", "NODE_ENV"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["CHEAPO_AUTH_TEST", "CHEAPO_FIELD_TEST", "EXPO_*", "REACT_NATIVE_PACKAGER_HOSTNAME"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", ".expo/types/**/*.ts", "expo-env.d.ts"]
    },
    "lint": {},
    "test": {},
    "ui:storybook:build": {
      "outputs": ["storybook-static/**"]
    }
  }
}
